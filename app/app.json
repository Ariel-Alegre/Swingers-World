{
  "expo": {
    "name": "Swingers World",
    "slug": "swingers-world",
    "scheme": "swingersworld",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/swingers-world.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.swingers.world",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "NSPhotoLibraryUsageDescription": "Swingers World needs access to your photos for your profile and chat.",
        "CFBundleLocalizations": [
          "es",
          "en"
        ]
      }
    },
    "android": {
      "package": "com.swingers.world",
      "versionCode": 1,
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/swingers-world.png",
        "backgroundColor": "#0B0710"
      }
    },
    "web": {
      "favicon": "./assets/swingers-world.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Swingers World needs access to your photos for your profile and chat."
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/swingers-world.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0B0710"
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Swingers World uses your approximate location to find people near your city."
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "es",
              "en"
            ],
            "android": [
              "es",
              "en"
            ]
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Swingers World needs microphone access to record voice messages.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset"
    ],
    "locales": {
      "es": "./locales/es.json",
      "en": "./locales/en.json"
    },
    "extra": {
      "eas": {
        "projectId": "81a91717-c11d-4743-8dfb-1c65711eb58b"
      }
    },
    "owner": "ariel-alegre"
  }
}
