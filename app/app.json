{
  "expo": {
    "name": "Swingers World",
    "slug": "swingers-world",
    "scheme": "swingersworld",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/swingers-world.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.swingers.world",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "NSPhotoLibraryUsageDescription": "Swingers World needs access to your photos to complete your profile."
      }
    },
    "android": {
      "package": "com.swingers.world",
      "versionCode": 1,
      "permissions": [
        "INTERNET"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/swingers-world.png",
        "backgroundColor": "#0B0710"
      }
    },
    "web": {
      "favicon": "./assets/swingers-world.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Swingers World needs access to your photos to complete your profile.",
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/swingers-world.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0B0710"
        }
      ],
      "expo-font",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Swingers World uses your approximate location to find people near your city."
        }
      ],
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": ["es", "en"],
            "android": ["es", "en"]
          }
        }
      ]
    ],
    "locales": {
      "es": "./locales/es.json",
      "en": "./locales/en.json"
    }
  }
}
