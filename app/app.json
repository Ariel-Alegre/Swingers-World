{
  "expo": {
    "name": "Swingers World",
    "slug": "swingers-world",
    "scheme": "swingersworld",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/swingers-world.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.swingers.world",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "Swingers World necesita acceso a tus fotos para completar tu perfil."
      }
    },
    "android": {
      "package": "com.swingers.world",
      "versionCode": 1,
      "permissions": [
        "INTERNET"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/swingers-world.png",
        "backgroundColor": "#0B0710"
      }
    },
    "web": {
      "favicon": "./assets/swingers-world.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Swingers World necesita acceso a tus fotos para completar tu perfil.",
          "microphonePermission": false
        }
      ],
      "expo-status-bar",
      [
        "expo-splash-screen",
        {
          "image": "./assets/swingers-world.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#0B0710"
        }
      ],
      "expo-font"
    ]
  }
}
